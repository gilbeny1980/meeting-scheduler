# Database (Turso). Leave empty for a local file database (local.db) during development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin page password (required to use /admin) and a random string for signing the login cookie
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional: confirmation emails via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM="Meetings <meetings@your-domain.com>"
# Optional: also send every new booking to this address
ADMIN_NOTIFY_EMAIL=

# Optional: shown to customers on the page and in emails
SITE_TITLE="קביעת פגישה"
MEETING_LOCATION=
